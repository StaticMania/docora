{
  "name": "docora",
  "version": "0.0.0",
  "private": true,
  "description": "Docora is an open-source documentation framework for Next.js and React, built with TypeScript, Tailwind CSS, and Markdown. Create fast, beautiful, SEO-friendly documentation sites with minimal configuration.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm run docs:dev",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:start": "pnpm --filter docs start",
    "playground:dev": "pnpm --filter playground dev",
    "playground:build": "pnpm --filter playground build",
    "build": "pnpm --filter create-docora build && pnpm run docs:build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build",
    "release:theme": "pnpm --filter docora publish --access public",
    "release:cli": "pnpm --filter create-docora publish --access public",
    "clean": "rimraf --glob \"**/node_modules\" \"**/.next\" \"**/dist\""
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.15.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StaticMania/docora.git"
  }
}
