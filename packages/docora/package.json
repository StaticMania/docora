{
  "name": "docora",
  "version": "0.0.1",
  "description": "Docora theme for Next.js — layouts, content pipeline, MDC components, search and SEO.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "next.mjs",
    "next.d.ts",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./next": {
      "types": "./next.d.ts",
      "default": "./next.mjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.69",
    "@mdx-js/mdx": "^3.1.1",
    "@shikijs/transformers": "^4.4.3",
    "ai": "^7.0.66",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-markdown": "^10.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdc": "^3.11.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.2.18",
    "mdast-util-to-hast": "^13.2.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "homepage": "https://github.com/StaticMania/docora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StaticMania/docora.git",
    "directory": "packages/docora"
  },
  "bugs": {
    "url": "https://github.com/StaticMania/docora/issues"
  },
  "keywords": [
    "nextjs",
    "documentation",
    "docs",
    "mdx",
    "mdc",
    "theme",
    "tailwindcss"
  ],
  "publishConfig": {
    "access": "public"
  }
}
