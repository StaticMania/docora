{
  "name": "docs-theme",
  "version": "0.0.0",
  "description": "Next.js documentation theme — layouts, MDX rendering and configuration",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "next.mjs",
    "next.d.ts",
    "styles.css",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./next": {
      "types": "./next.d.ts",
      "default": "./next.mjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@shikijs/rehype": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdc": "^3.11.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.2.18",
    "mdast-util-to-hast": "^13.2.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
