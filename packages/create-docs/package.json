{
  "name": "create-docs",
  "version": "0.1.0",
  "description": "Scaffold a Next.js documentation site",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-docs": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "node scripts/copy-templates.mjs && tsup",
    "dev": "node scripts/copy-templates.mjs && tsup --watch",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "homepage": "https://github.com/Arifulislam5577/next-docs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arifulislam5577/next-docs.git",
    "directory": "packages/create-docs"
  },
  "bugs": {
    "url": "https://github.com/Arifulislam5577/next-docs/issues"
  },
  "keywords": [
    "nextjs",
    "documentation",
    "docs",
    "scaffold",
    "cli",
    "create"
  ],
  "publishConfig": {
    "access": "public"
  }
}
